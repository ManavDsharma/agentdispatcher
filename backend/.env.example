# ServiceNow Table API credentials — never commit the real .env file.
# Leave unset to run the backend against mock ticket data instead.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password

# Internal ticket store. Leave DYNAMODB_TABLE_NAME unset to run against the
# in-memory mock dataset instead — same fallback philosophy as ServiceNow above.
# AWS credentials themselves are NOT set here — boto3 picks them up from the
# standard chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars, a shared
# ~/.aws/credentials profile, or an instance role). Never put AWS keys in this file.
DYNAMODB_TABLE_NAME=
AWS_REGION=us-east-1

# Origin(s) the frontend dev server runs on, comma-separated.
CORS_ORIGINS=http://localhost:5173
