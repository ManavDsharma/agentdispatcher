# ServiceNow Table API credentials — never commit the real .env file.
# Leave unset to run the backend against mock issue data instead.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password

# "Show Similar Incidents" API Gateway endpoint (Create Issue page). Leave
# unset to disable the button (backend returns 503, frontend shows an error).
SIMILAR_ISSUES_API_URL=https://your-api-id.execute-api.your-region.amazonaws.com/dev/servicenowapi
SIMILAR_ISSUES_API_KEY=

# Origin(s) the frontend dev server runs on, comma-separated.
CORS_ORIGINS=http://localhost:5173
