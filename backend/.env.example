# ServiceNow Table API credentials — never commit the real .env file.
# Leave unset to run the backend against mock ticket data instead.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password

# Origin(s) the frontend dev server runs on, comma-separated.
CORS_ORIGINS=http://localhost:5173
