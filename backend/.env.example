# Internal ticket store — DynamoDB is the single source of truth for tickets.
# Nothing else populates it from here; that ingestion happens externally.
# Leave DYNAMODB_TABLE_NAME unset to run against the in-memory mock dataset
# instead, so the app stays demoable without AWS access.
DYNAMODB_TABLE_NAME=
AWS_REGION=us-east-1

# Reference tables backing the ticket edit form's cascading dropdowns.
# Leave unset to run against in-memory mock reference data instead — same
# fallback philosophy as DYNAMODB_TABLE_NAME above.
# categorization_matrix schema: issue_id (PK), active, affected_service,
#   business_impact, category_description, category_name, created_on, impact,
#   issue, issue_description, issue_type, sub_category_description,
#   sub_category_name, team_id, updated_by, updated_on, urgency
CATEGORIZATION_MATRIX_TABLE_NAME=
# roster schema: UID (PK), active, created_on, days_availability, emp_id,
#   employee_id, employee_name, level, month, shift, shift_end_time,
#   shift_start_time, team_email_id, team_id, team_name, updated_by,
#   updated_on, year
ROSTER_TABLE_NAME=

# Explicit AWS credentials for local dev — read directly by the backend and
# passed to boto3. This file is gitignored, never commit real keys anywhere
# else. Leave both blank to fall back to boto3's own credential chain instead
# (a shared ~/.aws/credentials profile or an instance role) — prefer that for
# anything beyond local dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Origin(s) the frontend dev server runs on, comma-separated.
CORS_ORIGINS=http://localhost:5173
